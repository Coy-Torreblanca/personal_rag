# ==========================================
# STAGE 1: Dependencies
# ==========================================
FROM node:22-slim AS deps

WORKDIR /app

# Copy lockfiles first so the `npm ci` layer stays cached
# across rebuilds as long as dependencies don't change
COPY package.json package-lock.json ./

# Install ALL dependencies — devDependencies are needed to build
RUN npm ci

# ==========================================
# STAGE 2: Build
# ==========================================
FROM node:22-slim AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Build-time arguments. NEXT_PUBLIC_* values are inlined into the
# client bundle at build time, so they MUST be passed here (see
# docker-compose.prod.yml -> web.build.args).
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ENVIRONMENT=production
ARG NEXT_PUBLIC_ORGANIZATION_ID
ARG NEXT_PUBLIC_USER_ID

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT \
    NEXT_PUBLIC_ORGANIZATION_ID=$NEXT_PUBLIC_ORGANIZATION_ID \
    NEXT_PUBLIC_USER_ID=$NEXT_PUBLIC_USER_ID

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# Drop devDependencies now that the build is done
RUN npm prune --omit=dev

# ==========================================
# STAGE 3: Production runtime
# ==========================================
FROM node:22-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Run as a non-root user in production
RUN groupadd -r nextjs && useradd -r -g nextjs nextjs

COPY --from=builder --chown=nextjs:nextjs /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next ./.next
COPY --from=builder --chown=nextjs:nextjs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nextjs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nextjs /app/next.config.ts ./next.config.ts

USER nextjs

EXPOSE 3000

# Production server, listening on all interfaces so the
# 3000:3000 port mapping works from the host
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]
